# Copia este archivo a .env y ajusta si es necesario.

# --- Postgres (usado por docker-compose.yml y por Prisma) ---
DB_USER=aguas
DB_PASSWORD=aguas
DB_NAME=aguas
DB_PORT=5432

DATABASE_URL="postgresql://aguas:aguas@localhost:5432/aguas?schema=public"

# --- Servidor ---
PORT=3000
SESSION_SECRET=cambia-este-valor-en-produccion

# --- Hosting (Render + Neon u otro Postgres remoto) ---
# En producción: DB_SSL=true y DATABASE_URL apunta al Postgres de Neon (con
# ?sslmode=require al final, como lo entrega el dashboard de Neon). Ver README > Despliegue.
DB_SSL=false
